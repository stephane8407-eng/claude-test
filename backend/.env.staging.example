# ============================================================================
# SPV Treasure Map - STAGING Environment Configuration
# ============================================================================
# This file contains staging-specific settings
# Copy to .env on your staging server and update with actual values
# ============================================================================

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENVIRONMENT=staging

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Debug mode (staging can have debug for troubleshooting)
DEBUG=true

# Logging level (INFO for staging to see detailed logs)
LOG_LEVEL=INFO

# Server settings
HOST=0.0.0.0
PORT=8000

# Number of worker processes
WORKERS=2
WORKER_CLASS=uvicorn.workers.UvicornWorker

# ============================================================================
# DATABASE
# ============================================================================
# PostgreSQL connection string - UPDATE WITH STAGING DATABASE
DATABASE_URL=postgresql://staging_user:staging_password@staging-db-host:5432/spv_treasure_map_staging

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# JWT Secret Key - GENERATE A UNIQUE KEY FOR STAGING
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_staging_jwt_secret_key_here_at_least_32_characters

# JWT settings
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CSRF Protection
CSRF_ENABLED=true
CSRF_SECRET_KEY=your_staging_csrf_secret_key_here

# ============================================================================
# CORS
# ============================================================================
# Staging frontend URL
CORS_ORIGINS=https://staging.spvtreasurehunt.com

# ============================================================================
# API KEYS FOR EXTERNAL SERVICES
# ============================================================================
# Anthropic Claude API Key - USE STAGING KEY WITH LIMITS
ANTHROPIC_API_KEY=sk-ant-api03-staging-key-here

# Google API keys (optional)
GOOGLE_API_KEY=staging_google_api_key_here
GOOGLE_CSE_ID=staging_google_cse_id_here

# ============================================================================
# FILE UPLOAD SETTINGS
# ============================================================================
MAX_FILE_SIZE_MB=5
MAX_REQUEST_SIZE_MB=10
MAX_IMAGE_WIDTH=1920
MAX_IMAGE_HEIGHT=1920

# ============================================================================
# SECURITY
# ============================================================================
# Enable security headers in staging
ENABLE_SECURITY_HEADERS=true

# ============================================================================
# RATE LIMITING
# ============================================================================
# Enable rate limiting in staging
RATE_LIMIT_ENABLED=true

# ============================================================================
# REDIS CACHE
# ============================================================================
# Redis URL - UPDATE WITH STAGING REDIS
REDIS_URL=redis://staging-redis-host:6379/0

# Cache settings
CACHE_ENABLED=true
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=3600
CACHE_TTL_LONG=86400

# ============================================================================
# MONITORING & ERROR TRACKING
# ============================================================================
# Sentry DSN - USE STAGING PROJECT
SENTRY_DSN=https://staging-sentry-dsn@sentry.io/staging-project-id

# Enable Sentry in staging
SENTRY_ENABLED=true

# Sample rates (higher for staging to catch more issues)
SENTRY_TRACES_SAMPLE_RATE=0.5
SENTRY_PROFILES_SAMPLE_RATE=0.5

# ============================================================================
# HEALTH CHECKS
# ============================================================================
HEALTH_CHECK_ENABLED=true

# ============================================================================
# STAGING NOTES
# ============================================================================
# 1. This environment should closely mirror production
# 2. Use separate database and Redis instances from production
# 3. Can use higher logging levels and sample rates for debugging
# 4. Test all production features here before deploying to production
# 5. Use test API keys with limits where possible
# ============================================================================
