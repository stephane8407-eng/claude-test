# Database Configuration
DATABASE_URL=postgresql://spv_admin:your_password_here@localhost:5432/spv_treasure_map

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=True

# API Keys (for AI scrapers)
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CSE_ID=your_google_cse_id
ANTHROPIC_API_KEY=your_anthropic_api_key

# Security (generate random strings for production)
SECRET_KEY=your-secret-key-for-jwt-tokens-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
