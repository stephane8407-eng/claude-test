# ============================================================================
# SPV Treasure Map - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)
# ============================================================================

# ============================================================================
# DATABASE
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://your_username:your_password@localhost:5432/spv_treasure_map

# ============================================================================
# ENVIRONMENT
# ============================================================================
# Options: development, staging, production
ENVIRONMENT=development

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# JWT Secret Key - MUST be changed in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_secret_key_here_at_least_32_characters_long

# JWT Algorithm (default: HS256)
JWT_ALGORITHM=HS256

# JWT token expiration in hours (default: 24)
JWT_EXPIRATION_HOURS=24

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# API KEYS FOR EXTERNAL SERVICES
# ============================================================================

# Anthropic Claude API Key (required for AI identity generation)
# Get from: https://console.anthropic.com/settings/keys
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Custom Search API (optional - for web scraping)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=your_google_api_key_here

# Google Custom Search Engine ID (optional - for web scraping)
# Get from: https://programmablesearchengine.google.com/
GOOGLE_CSE_ID=your_google_cse_id_here

# ============================================================================
# FILE UPLOAD SETTINGS
# ============================================================================
# Maximum file size in MB (default: 5MB)
MAX_FILE_SIZE_MB=5

# Maximum request body size in MB (default: 10MB)
MAX_REQUEST_SIZE_MB=10

# Maximum image dimensions in pixels (default: 1920x1920)
MAX_IMAGE_WIDTH=1920
MAX_IMAGE_HEIGHT=1920

# ============================================================================
# SECURITY
# ============================================================================
# Enable security headers (default: true)
ENABLE_SECURITY_HEADERS=true

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit this file with real values to git
# 2. Keep your .env file secure and backed up separately
# 3. Use different values for development, staging, and production
# 4. Rotate secrets regularly (especially in production)
# 5. Use strong, randomly generated secrets
# ============================================================================
