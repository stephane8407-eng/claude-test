# ============================================================================
# SPV Treasure Map - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)
# ============================================================================

# ============================================================================
# DATABASE
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://your_username:your_password@localhost:5432/spv_treasure_map

# ============================================================================
# ENVIRONMENT
# ============================================================================
# Options: development, staging, production
# Each environment has different defaults for DEBUG, LOG_LEVEL, CORS, etc.
ENVIRONMENT=development

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Debug mode (default: true for dev, false for staging/prod)
# DEBUG=false

# Logging level (default: DEBUG for dev, INFO for staging, WARNING for prod)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Server settings
HOST=0.0.0.0
PORT=8000

# Number of worker processes (for production with Gunicorn)
WORKERS=4
WORKER_CLASS=uvicorn.workers.UvicornWorker

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# JWT Secret Key - MUST be changed in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_secret_key_here_at_least_32_characters_long

# JWT Algorithm (default: HS256)
JWT_ALGORITHM=HS256

# JWT token expiration in hours (default: 24)
JWT_EXPIRATION_HOURS=24

# CSRF Protection (default: true)
CSRF_ENABLED=true
# CSRF_SECRET_KEY=your_csrf_secret_key_here

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================
# Comma-separated list of allowed origins
# Environment-specific defaults:
# - development: http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000
# - staging: https://staging.spvtreasurehunt.com
# - production: https://spvtreasurehunt.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# API KEYS FOR EXTERNAL SERVICES
# ============================================================================

# Anthropic Claude API Key (required for AI identity generation)
# Get from: https://console.anthropic.com/settings/keys
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Custom Search API (optional - for web scraping)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=your_google_api_key_here

# Google Custom Search Engine ID (optional - for web scraping)
# Get from: https://programmablesearchengine.google.com/
GOOGLE_CSE_ID=your_google_cse_id_here

# ============================================================================
# FILE UPLOAD SETTINGS
# ============================================================================
# Maximum file size in MB (default: 5MB)
MAX_FILE_SIZE_MB=5

# Maximum request body size in MB (default: 10MB)
MAX_REQUEST_SIZE_MB=10

# Maximum image dimensions in pixels (default: 1920x1920)
MAX_IMAGE_WIDTH=1920
MAX_IMAGE_HEIGHT=1920

# ============================================================================
# SECURITY
# ============================================================================
# Enable security headers (default: false for dev, true for staging/prod)
# ENABLE_SECURITY_HEADERS=true

# ============================================================================
# RATE LIMITING
# ============================================================================
# Enable rate limiting (default: false for dev, true for staging/prod)
# RATE_LIMIT_ENABLED=true

# ============================================================================
# REDIS CACHE
# ============================================================================
# Redis URL (optional - falls back to in-memory cache if not set)
# Format: redis://username:password@host:port/db
# For local Redis: redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/0

# Cache enabled (default: true if REDIS_URL is set, false otherwise)
# CACHE_ENABLED=true

# Cache TTL settings in seconds
CACHE_TTL_SHORT=300      # 5 minutes
CACHE_TTL_MEDIUM=3600    # 1 hour
CACHE_TTL_LONG=86400     # 24 hours

# ============================================================================
# MONITORING & ERROR TRACKING
# ============================================================================
# Sentry DSN (optional - for error tracking)
# Get from: https://sentry.io/settings/[org]/projects/[project]/keys/
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# Enable Sentry (default: false for dev, true for staging/prod)
# SENTRY_ENABLED=true

# Sentry sample rates (0.0 to 1.0)
# Lower values reduce overhead and costs
SENTRY_TRACES_SAMPLE_RATE=0.1    # 10% of transactions
SENTRY_PROFILES_SAMPLE_RATE=0.1  # 10% of transactions

# ============================================================================
# HEALTH CHECKS
# ============================================================================
# Enable health check endpoints (default: true)
HEALTH_CHECK_ENABLED=true

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit this file with real values to git
# 2. Keep your .env file secure and backed up separately
# 3. Use different values for development, staging, and production
# 4. Rotate secrets regularly (especially in production)
# 5. Use strong, randomly generated secrets
# 6. Environment-specific defaults are automatically applied based on ENVIRONMENT
# ============================================================================
