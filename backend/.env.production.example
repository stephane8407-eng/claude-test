# ============================================================================
# SPV Treasure Map - PRODUCTION Environment Configuration
# ============================================================================
# This file contains production-specific settings
# Copy to .env on your production server and update with actual values
# CRITICAL: Keep this file secure and never commit to git
# ============================================================================

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENVIRONMENT=production

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Debug mode (MUST be false in production)
DEBUG=false

# Logging level (WARNING or ERROR for production)
LOG_LEVEL=WARNING

# Server settings
HOST=0.0.0.0
PORT=8000

# Number of worker processes (adjust based on server CPU cores)
# Rule of thumb: 2-4 workers per CPU core
WORKERS=4
WORKER_CLASS=uvicorn.workers.UvicornWorker

# ============================================================================
# DATABASE
# ============================================================================
# PostgreSQL connection string - UPDATE WITH PRODUCTION DATABASE
# CRITICAL: Use strong password, SSL connection, restricted access
DATABASE_URL=postgresql://prod_user:strong_production_password@prod-db-host:5432/spv_treasure_map

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# JWT Secret Key - GENERATE A STRONG UNIQUE KEY FOR PRODUCTION
# CRITICAL: This must be different from staging/development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARACTERS_LONG

# JWT settings
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CSRF Protection (required in production)
CSRF_ENABLED=true
CSRF_SECRET_KEY=CHANGE_THIS_TO_ANOTHER_STRONG_RANDOM_SECRET

# ============================================================================
# CORS
# ============================================================================
# Production frontend URL ONLY
# CRITICAL: Only include your actual production domain
CORS_ORIGINS=https://spvtreasurehunt.com

# ============================================================================
# API KEYS FOR EXTERNAL SERVICES
# ============================================================================
# Anthropic Claude API Key - USE PRODUCTION KEY
# CRITICAL: Monitor usage and set appropriate limits
ANTHROPIC_API_KEY=sk-ant-api03-production-key-here

# Google API keys (optional)
GOOGLE_API_KEY=production_google_api_key_here
GOOGLE_CSE_ID=production_google_cse_id_here

# ============================================================================
# FILE UPLOAD SETTINGS
# ============================================================================
MAX_FILE_SIZE_MB=5
MAX_REQUEST_SIZE_MB=10
MAX_IMAGE_WIDTH=1920
MAX_IMAGE_HEIGHT=1920

# ============================================================================
# SECURITY
# ============================================================================
# Security headers MUST be enabled in production
ENABLE_SECURITY_HEADERS=true

# ============================================================================
# RATE LIMITING
# ============================================================================
# Rate limiting MUST be enabled in production
RATE_LIMIT_ENABLED=true

# ============================================================================
# REDIS CACHE
# ============================================================================
# Redis URL - UPDATE WITH PRODUCTION REDIS
# CRITICAL: Use password-protected Redis, SSL if possible
REDIS_URL=redis://:redis_password@prod-redis-host:6379/0

# Cache settings
CACHE_ENABLED=true
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=3600
CACHE_TTL_LONG=86400

# ============================================================================
# MONITORING & ERROR TRACKING
# ============================================================================
# Sentry DSN - USE PRODUCTION PROJECT
# CRITICAL: Set up alerts for critical errors
SENTRY_DSN=https://production-sentry-dsn@sentry.io/production-project-id

# Sentry enabled in production
SENTRY_ENABLED=true

# Sample rates (keep low in production to reduce overhead)
# 10% is usually sufficient for production monitoring
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ============================================================================
# HEALTH CHECKS
# ============================================================================
HEALTH_CHECK_ENABLED=true

# ============================================================================
# PRODUCTION SECURITY CHECKLIST
# ============================================================================
# Before deploying to production, ensure:
#
# 1. SECRETS & KEYS:
#    [ ] JWT_SECRET_KEY is unique, strong (64+ chars), and never committed
#    [ ] CSRF_SECRET_KEY is different from JWT secret
#    [ ] All API keys are production keys with appropriate limits
#    [ ] Database password is strong and unique
#    [ ] Redis password is set and strong
#
# 2. SECURITY SETTINGS:
#    [ ] DEBUG=false
#    [ ] ENABLE_SECURITY_HEADERS=true
#    [ ] RATE_LIMIT_ENABLED=true
#    [ ] CSRF_ENABLED=true
#    [ ] CORS_ORIGINS only includes production domain (no wildcards)
#
# 3. DATABASE:
#    [ ] Database uses SSL connection
#    [ ] Database user has minimal required permissions
#    [ ] Regular backups are configured and tested
#    [ ] Database is not publicly accessible
#
# 4. MONITORING:
#    [ ] Sentry is configured with alerts
#    [ ] Log aggregation is set up
#    [ ] Health checks are monitored
#    [ ] Uptime monitoring is in place
#
# 5. INFRASTRUCTURE:
#    [ ] HTTPS is enforced
#    [ ] Firewall rules are configured
#    [ ] Servers are patched and updated
#    [ ] Redis is password-protected
#    [ ] Environment variables are stored securely
#
# 6. BACKUPS:
#    [ ] Database backups run daily
#    [ ] Backup restoration has been tested
#    [ ] Backups are stored securely offsite
#    [ ] Backup retention policy is defined
#
# 7. DEPLOYMENT:
#    [ ] CI/CD pipeline tests pass
#    [ ] Staging environment tested
#    [ ] Rollback plan is documented
#    [ ] Team is notified of deployment
# ============================================================================
